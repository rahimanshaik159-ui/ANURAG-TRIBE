# Copy to functions/.env (or .env.<projectId>) before `firebase deploy`.
# These are NON-secret parameters. Secrets (API keys) use Secret Manager:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set TURN_SHARED_SECRET     (enter the word  unset  if you have no TURN server)

# Public base URL of the deployed site (used for links inside emails)
APP_URL=https://YOUR-PROJECT-ID.web.app

# Comma-separated list of emails that become SUPER ADMIN after they verify
# their email and sign in once. Keep this list tiny.
SUPER_ADMIN_EMAILS=you@example.com

# Sender for transactional email (domain must be verified in Resend)
EMAIL_FROM=ANURAG TRIBE <no-reply@your-domain.com>

# Optional TURN server (coturn with `use-auth-secret`). Comma-separated URLs.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
